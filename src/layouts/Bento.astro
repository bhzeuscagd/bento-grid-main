---
import GridCol from "../components/GridCol.astro";
import star from "../assets/images/illustration-five-stars.webp";
import social from "../assets/images/illustration-multiple-platforms.webp";
import schedule from "../assets/images/illustration-consistent-schedule.webp";
import post from "../assets/images/illustration-schedule-posts.webp";
import followers from "../assets/images/illustration-grow-followers.webp";
import audience from "../assets/images/illustration-audience-growth.webp";
import createpost from "../assets/images/illustration-create-post.webp";
import ai from "../assets/images/illustration-ai-content.webp";
---

<section class="mx-3.5 my-7 lg:mx-20 lg:my-20">
    <div
        class="grid grid-cols-1 auto-rows-[10px] gap-4 min-w-0 lg:grid-cols-4 lg:auto-rows-[140px]"
    >
        <GridCol
            class="row-span-11 bg-purple-500 p-10 flex flex-col items-center justify-center shadow-2xs lg:col-span-2 lg:row-span-2 lg:col-start-2 lg:row-start-1"
            text='Social Media <span class="text-yellow-500 text-shadow-lg/30">10x</span> Faster with AI'
            textclass="text-white text-4xl text-center lg:text-6xl"
            src={star.src}
            srcclass="w-32 max-lg:max-w-32 pt-5 lg:w-52"
            subtext="Over 4,000 5-star reviews"
            subtextclass="text-white text-center lg:text-xl"
        />
        <GridCol
            class="row-span-7 bg-white p-8 flex flex-col-reverse items-start justify-center shadow-2xs gap-5 lg:row-span-2 lg:col-start-2 lg:row-start-3 lg:relative overflow-hidden"
            text="Manage multiple accounts and platforms"
            textclass="font-dm-sans font-semibold text-black text-xl text-wrap lg:text-3xl mt-20"
            src={social.src}
            srcclass="w-full max-lg:max-w-72 h-auto rounded-full shadow-md lg:min-w-88 lg:absolute lg:top-1/8 lg:left-1/3 lg:-translate-x-1/5 lg:-translate-y-1/5"
        />
        <GridCol
            class="row-span-9 bg-yellow-500 pt-4 pl-4 flex flex-col items-start justify-center shadow-2xs gap-3 overflow-hidden lg:row-span-2 lg:col-start-3 lg:row-start-3"
            text="Maintain a consistent posting schedules"
            textclass="font-dm-sans font-semibold text-black text-xl w-full mt-6 lg:text-3xl translate-y-10 lg:ml-3"
            src={schedule.src}
            srcclass="w-48 max-lg:max-w-48 h-auto lg:w-60 translate-y-11 lg:pl-3"
        />
        <GridCol
            class="row-span-18 bg-purple-300 py-10 px-4 flex flex-col items-center justify-center shadow-2xs gap-5 lg:row-span-4 lg:col-start-4 lg:row-start-1 lg:justify-start lg:items-start lg:pl-10 lg:overflow-hidden"
            text="Schedule to social media."
            textclass="font-dm-sans font-bold text-black text-xl w-full text-center lg:text-3xl lg:text-left"
            src={post.src}
            srcclass="w-full max-lg:max-w-72 h-auto lg:min-w-96"
            subtext="Optimize post timing to publish  content at the perfect time for your audience."
            subtextclass="text-black text-center text-lg font-dm-sans font-semibold lg:text-left lg:text-lg lg:leading-none lg:text-balance lg:font-normal"
        />
        <GridCol
            class="row-span-14 bg-purple-500 px-15 flex flex-col-reverse items-center justify-center shadow-2xs gap-7 lg:col-span-2 lg:row-span-2 lg:col-start-3 lg:row-start-5 lg:flex-row-reverse lg:p-0 lg:pt-5 lg:gap-4"
            text="Grow followers with non-stop content."
            textclass="font-dm-sans font-semibold text-white text-2xl w-full text-center lg:text-left lg:text-3xl"
            src={followers.src}
            srcclass="w-full lg:max-w-72 h-auto -mt-5 lg:min-w-72"
        />
        <GridCol
            class="row-span-8 bg-white px-6 flex flex-col items-start justify-center shadow-2xs gap-2 lg:row-span-2 lg:col-start-2 lg:row-start-5 lg:justify-between lg:py-10"
            text=">56%"
            textclass="font-dm-sans font-semibold text-black text-5xl w-full text-wrap order-1 lg:text-7xl"
            src={audience.src}
            srcclass="w-40 h-auto  order-3 lg:w-48"
            subtext="faster audience growth"
            subtextclass="font-dm-sans font-semibold text-black text-center order-2 lg:text-xl lg:text-center lg:font-normal"
        />
        <GridCol
            class="row-span-8 bg-yellow-100 p-10 flex flex-col items-start justify-center shadow-2xs gap-5 lg:row-span-3 lg:col-start-1 lg:row-start-1"
            text="Create and schedule content <span class='text-purple-500 italic'>quicker.</span>"
            textclass="font-dm-sans font-semibold text-black text-2xl w-full text-wrap mt-6 lg:text-3xl"
            src={createpost.src}
            srcclass="w-40 h-auto lg:w-48"
        />
        <GridCol
            class="row-span-13 bg-yellow-500 px-5 flex flex-col items-start justify-center shadow-2xs gap-5 lg:row-span-3 lg:col-start-1 lg:row-start-4 lg:justify-between"
            text="Write your content using AI."
            textclass="font-dm-sans font-semibold text-black text-3xl w-full text-wrap mt-6 lg:text-4xl"
            src={ai.src}
            srcclass="w-50 h-auto lg:w-60"
        />
    </div>
</section>
